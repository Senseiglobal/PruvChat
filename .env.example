# PruvChat env template. Copy to .env for local runs. Never commit secrets.
# Mock assessment runs offline by default; live calls need explicit approval.
# Verified against https://dev.meta.ai/docs (Oct 2026): base https://api.meta.ai/v1,
# Bearer $MODEL_API_KEY, model muse-spark-1.3. Promo API credits do NOT cover
# Muse Code subscription charges — those bill separately.
MODEL_API_KEY=
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
PRUV_MOCK_MODE=true
PRUV_ALLOW_NETWORK_FETCH=false
